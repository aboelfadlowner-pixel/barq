# Database: Supabase connection string for the store_app role (transaction pooler, port 6543).
# Without it the site keeps its data in .data/store.json (development only).
DATABASE_URL=
# Dashboard passwords. Required in production; in development they default to "admin" and "callcenter".
ADMIN_PASSWORD=
CALLCENTER_PASSWORD=
# Optional: key used to sign the dashboard session cookie. If empty it is derived from ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=
# Which part this deployment serves: "store" (the shop only), "admin" (the dashboard only), or empty for both.
APP_PART=
# On the dashboard deployment: the store's address, for the «فتح المتجر» links (e.g. https://abuelfadl.com).
NEXT_PUBLIC_STORE_URL=
# Store side, optional: while set, the store asks for this password before showing anything (preview before launch).
# Remove it on launch day to open the store to everyone.
PREVIEW_PASSWORD=
# Both deployments, same value (32+ random letters/numbers): lets the dashboard tell the store to show a change at once.
REVALIDATE_SECRET=
